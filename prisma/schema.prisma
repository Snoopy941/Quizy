generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String         @default("")
  avatar       String?
  tokenVersion Int            @default(0) // bump to sign out every session
  recoveryHash String? // bcrypt hash of the account recovery code
  googleSub    String?        @unique // Google account id, when signed in with Google
  createdAt    DateTime       @default(now())
  settings     UserSettings?
  decks        Deck[]
  sessions     StudySession[]
}

model Deck {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String         @default("")
  pdfUrl        String? // source file served by /api/files (PDF, DOCX, PPTX, TXT, image)
  sourceType    String         @default("pdf") // pdf | docx | pptx | text | image | anki
  aiSource      String? // which AI wrote the cards: builtin | api | demo
  cardLanguage  String         @default("auto") // language the cards are written in (auto = same as source)
  ocrLanguage   String         @default("eng") // Tesseract language code(s) for scanned pages/images
  figures       String? // JSON { "<page>": "/api/images/<file>" } — main figure on each source page
  instructions  String         @default("")
  density       String         @default("medium") // low | medium | high
  pinned        Boolean        @default(false)
  shareId       String?        @unique
  // processing state
  genStatus     String         @default("idle") // idle | extracting | generating | done | error
  genProgress   Int            @default(0) // 0-100
  genError      String?
  lastStudiedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cards         Card[]
  chunks        DeckChunk[]
  sessions      StudySession[]

  @@index([userId])
}

model DeckChunk {
  id        String @id @default(cuid())
  deckId    String
  deck      Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  position  Int
  heading   String @default("")
  text      String
  status    String @default("pending") // pending | done | failed
  cardCount Int    @default(4)
  pageStart Int? // first source page (or slide) this section covers
  pageEnd   Int?
  pageMap   String? // JSON [[charOffset, page], ...] for locating card sources
  summary   String? // AI summary of this section (cheat sheet)
  cards     Card[]

  @@index([deckId])
}

model Card {
  id           String        @id @default(cuid())
  deckId       String
  deck         Deck          @relation(fields: [deckId], references: [id], onDelete: Cascade)
  chunkId      String?
  chunk        DeckChunk?    @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  front        String
  back         String
  type         String        @default("definition") // definition | fill-blank | mc | true-false | short-answer
  options      String? // JSON array for mc
  difficulty   String        @default("medium") // easy | medium | hard
  category     String        @default("General")
  position     Int           @default(0)
  sourcePage   Int? // page (or slide) the card was written from
  sourceQuote  String? // short verbatim snippet from the source backing the answer
  imageUrl     String? // figure shown with the card (from the source page, or added by the user)
  // FSRS scheduling state (null fsrsState = card still carries legacy SM-2 state)
  stability    Float?
  fsrsDifficulty Float?
  fsrsState    Int? // 0 new | 1 learning | 2 review | 3 relearning
  lastReviewAt DateTime?
  // legacy SM-2 state (kept for history + intervalDays/reps used by stats)
  easeFactor   Float         @default(2.5)
  intervalDays Float         @default(0)
  dueDate      DateTime      @default(now())
  reps         Int           @default(0)
  lapses       Int           @default(0)
  timesSeen    Int           @default(0)
  timesFailed  Int           @default(0)
  createdAt    DateTime      @default(now())
  sessionCards SessionCard[]

  @@index([deckId])
  @@index([dueDate])
}

model StudySession {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId           String?
  deck             Deck?         @relation(fields: [deckId], references: [id], onDelete: SetNull)
  mode             String        @default("normal") // normal | timed
  timerMinutes     Int?
  status           String        @default("active") // active | completed | abandoned
  startedAt        DateTime      @default(now())
  endedAt          DateTime?
  cardsReviewed    Int           @default(0)
  correctCount     Int           @default(0)
  timeSpentSeconds Int           @default(0)
  cards            SessionCard[]

  @@index([userId])
  @@index([deckId])
}

model SessionCard {
  id               String       @id @default(cuid())
  sessionId        String
  session          StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cardId           String?
  card             Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  grade            String // again | hard | good | easy | skip
  timeSpentSeconds Int          @default(0)
  correct          Boolean      @default(false)
  reviewedAt       DateTime     @default(now())

  @@index([sessionId])
}

model UserSettings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               String  @default("dark")
  defaultTimerMinutes Int     @default(10)
  cardDensity         String  @default("medium") // low | medium | high
  soundEnabled        Boolean @default(true)
  // AI provider: auto | builtin | api
  aiProvider          String  @default("auto")
  aiBaseUrl           String  @default("")
  aiApiKey            String  @default("")
  aiModel             String  @default("")
  readAloud           Boolean @default(false)
}
