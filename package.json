{
  "name": "quizy",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "prisma migrate deploy && next start -p 4000",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "sample-pdf": "tsx scripts/make-sample-pdf.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:ui": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "jose": "^5.9.6",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.1",
    "unpdf": "^1.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.1",
    "prisma": "^6.5.0",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@playwright/test": "^1.56.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
