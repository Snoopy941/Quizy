{
  "name": "quizy",
  "version": "1.2.1",
  "description": "AI-powered study companion \u2014 turn any PDF, slides or notes into smart flashcards",
  "main": "index.js",
  "author": "Quizy <hello@quizy.study>",
  "homepage": "https://quizy.study",
  "license": "Proprietary",
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "study.quizy.desktop",
    "productName": "Quizy",
    "copyright": "Copyright \u00a9 2026 Quizy (quizy.study)",
    "directories": {
      "output": "installer-out"
    },
    "files": [
      "index.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staging/app",
        "to": "app"
      },
      {
        "from": "staging/bin",
        "to": "bin"
      },
      {
        "from": "staging/seed",
        "to": "seed"
      },
      {
        "from": "staging/ai",
        "to": "ai"
      },
      {
        "from": "staging/licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "staging/icon.ico",
      "artifactName": "Quizy-Setup-${version}.${ext}",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "Quizy-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": true,
      "license": "LICENSE.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quizy",
      "uninstallDisplayName": "Quizy \u2014 AI Flashcards from Any PDF",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Quizy-Setup-${version}.${ext}",
      "include": "installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Snoopy941",
        "repo": "Quizy"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
