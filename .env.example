# Database (SQLite). For Postgres: postgresql://user:pass@host:5432/quizy
DATABASE_URL="file:./data/quizy.db"

# Session signing secret — generate with: openssl rand -hex 32
JWT_SECRET="change-me"

# Public URL of the app (used for share links, OAuth callbacks)
NEXTAUTH_URL="https://quizy.study"

# Canonical public URL baked into share links and metadata.
# Leave unset for production (defaults to https://quizy.study);
# set to http://localhost:4000 only for local development if desired.
NEXT_PUBLIC_SITE_URL=""

# ---- AI card generation ----
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, Together, Ollama…).
OPENAI_API_KEY=""
OPENAI_BASE_URL=""          # e.g. https://openrouter.ai/api/v1  (leave empty for OpenAI)
OPENAI_MODEL="gpt-4o-mini"  # e.g. llama3.1 via Ollama

# Set to 1 to use the built-in deterministic mock generator (no API key needed)
MOCK_AI="1"

# Where uploaded PDFs are stored (volume-mount in Docker)
UPLOAD_DIR="./data/uploads"
